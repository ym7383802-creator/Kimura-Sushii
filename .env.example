# GEMINI_API_KEY: Optional for Gemini AI API calls.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Persistent Database (Required on Vercel for permanent storage across refreshes & redeployments)
# Option A (Recommended): PostgreSQL / Supabase / Neon connection string
# DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"
# Option B: Supabase REST API
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Admin Authentication (Recommended in Vercel Environment Variables)
# ADMIN_USERNAME="admin@kimurasushi.com"
# ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
# ADMIN_PASSWORD_HASH=""

# WhatsApp Business Cloud API (Optional: enables automatic order delivery via Meta WhatsApp API)
# If omitted, checkout provides a direct prefilled WhatsApp link to 01155412188.
# WHATSAPP_CLOUD_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_RECIPIENT_NUMBER="201155412188"
